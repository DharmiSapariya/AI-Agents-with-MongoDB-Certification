MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
OPENAI_API_KEY=
VOYAGE_API_KEY=

# APP_MODE: auto (live when all three credentials are set), demo (never contact services), live (fail at startup if incomplete)
APP_MODE=auto
LOG_LEVEL=INFO
# Extra regexes to redact from logs, as a JSON list: ["internal-[a-z0-9]+"]
LOG_REDACT_PATTERNS=[]
# Optional tuning: MONGO_TIMEOUT_MS, MONGO_MAX_POOL_SIZE, LLM_TIMEOUT_S, LLM_MAX_RETRIES,
# EMBEDDING_TIMEOUT_S, EMBEDDING_MAX_RETRIES, MAX_GRAPH_STEPS

# Auth: required for live mode. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional: JWT_ISSUER, JWT_AUDIENCE, ACCESS_TOKEN_TTL_MINUTES (default 30), AUTH_MAX_CONCURRENT_HASHES (default 4)
